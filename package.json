{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "registry:source": "bun scripts/registry/generate-source.ts",
    "registry:clean": "bun scripts/registry/clean-output.ts",
    "registry:generate": "bun run registry:source && bun run registry:clean && shadcn build && bun scripts/registry/finalize-registry.ts && bun run registry:validate",
    "registry:validate": "bun scripts/registry/validate.ts",
    "registry:check": "bun run registry:validate",
    "registry:build": "bun run registry:generate",
    "architecture:validate": "bun scripts/architecture/validate.ts",
    "predev": "bun run registry:check",
    "prebuild": "bun run registry:check",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run lint && bun run typecheck && bun run test && bun run architecture:validate && bun run format:check && bun run registry:check"
  },
  "dependencies": {
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@rexa-developer/tiks": "^0.3.0",
    "@shadcn/react": "^0.1.0",
    "@shikijs/transformers": "^4.0.2",
    "@tabler/icons-react": "^3.44.0",
    "@vemetric/web": "^0.6.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cobe": "0.6.4",
    "gsap": "^3.15.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "react-use-measure": "^2.1.7",
    "resend": "^6.12.4",
    "shadcn": "^4.8.0",
    "shaders": "^2.5.124",
    "shiki": "^4.0.2",
    "skills": "^1.5.15",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwind-scrollbar": "^4.0.2",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "web-haptics": "^0.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
