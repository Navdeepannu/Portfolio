# Canonical site URL (production). Vercel: add in Project → Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional Vemetric browser analytics.
NEXT_PUBLIC_VEMETRIC_TOKEN=

# PostHog browser analytics.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-only GitHub data. Never prefix these with NEXT_PUBLIC_.
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=

# Server-only contact form delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Portfolio <contact@example.com>"
CONTACT_TO_EMAIL=you@example.com

# Optional server-only public analytics adapter. The homepage section stays hidden without these.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Required only when the Vercel project belongs to a team.
VERCEL_TEAM_ID=
