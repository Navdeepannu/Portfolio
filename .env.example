# Canonical site URL (production). Vercel: add in Project → Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://navdeepsingh.dev

# Server-only GitHub data. Never prefix these with NEXT_PUBLIC_.
GITHUB_USERNAME=navdeepannu
GITHUB_TOKEN=

# Optional server-only public analytics adapter. The homepage section stays hidden without these.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Required only when the Vercel project belongs to a team.
VERCEL_TEAM_ID=
